# Referencia: compose.yaml pasa estos mismos valores como flags (ver comentario allí).
[mysqld]
character-set-server   = utf8mb4
collation-server       = utf8mb4_unicode_ci
default-time-zone      = '-05:00'
sql_mode               = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# Rendimiento estable para el benchmark (mismos valores en A y B)
innodb_buffer_pool_size        = 1G
innodb_flush_log_at_trx_commit = 1
sync_binlog                    = 1
max_connections                = 300
max_allowed_packet     = 256M
# Permite a prep crear los triggers de 002 con binlog activo
log_bin_trust_function_creators = 1

# Mediciones de almacenamiento por tabla
innodb_file_per_table = ON

# Evitar SELECT ... INTO OUTFILE desde la app
secure_file_priv = NULL
