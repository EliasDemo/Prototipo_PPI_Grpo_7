# Versiones exactas de Fabric (F4.1). Las leen up.sh, deploy-cc.sh y la imagen del chaincode.
# Instalación: install-fabric.sh --fabric-version 2.5.16 --ca-version 1.5.22 binary docker
# (binarios en infra/fabric/bin y configuración de referencia en infra/fabric/config; ambos ignorados por git)

FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.22

# Digests verificados el 27/10/2026 (docker image inspect ... RepoDigests)
IMAGEN_PEER=hyperledger/fabric-peer:2.5.16@sha256:58979b65744b5e7f775d5c65af3831d9beb344d8294c6aa82cbae59e7f7760d6
IMAGEN_ORDERER=hyperledger/fabric-orderer:2.5.16@sha256:1d918fc7e1e05b28a9a2f91a61f6435d058f156ef97b5005271de66fbf1370f1
IMAGEN_CCENV=hyperledger/fabric-ccenv:2.5.16@sha256:807493f095f65140ad4cd4543a824c9021a848c8c7aace9bec512e8545e870f1
IMAGEN_BASEOS=hyperledger/fabric-baseos:2.5.16@sha256:109b4a15b28235db0dcf6ecaa7ffd41dbeeecee6551b231d8178dcf574a9157b
IMAGEN_CA=hyperledger/fabric-ca:1.5.22@sha256:87c36f0b655838e2c3b00379cafc6efb36dc6f8d88b2cec9c707fd47e93b1c63

# Base de la imagen del chaincode (Chaincode como servicio, ADR-016)
IMAGEN_NODE_CC=node:20.19.5-alpine3.22@sha256:6178e78b972f79c335df281f4b7674a2d85071aae2af020ffa39f0a770265435

# Recursos fijos por contenedor: son parámetro del experimento (docs/entorno.md).
CPU_ORDERER=1.0
MEM_ORDERER=1g
CPU_PEER=1.5
MEM_PEER=2g
CPU_CC=0.5
MEM_CC=512m

# Tamaño máximo (bytes) del evento sintético del modo A; igual en todos los peers (determinismo)
CC_TAMANO_MAX_EVENTO=4096
