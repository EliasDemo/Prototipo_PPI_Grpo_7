{
  "name": "prototipo-ppi-grupo-7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env -f infra/mysql/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/mysql/compose.yaml down",
    "db:import": "bash scripts/data/importar-origen.sh",
    "db:verify": "tsx --env-file=.env scripts/data/verificar-origen.ts",
    "db:migrate": "bash scripts/data/migrar-experimental.sh",
    "db:reset-exp": "bash scripts/data/reset-experimental.sh"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
