{
  "name": "investigacion-blockchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose --env-file .env -f infra/mysql/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/mysql/compose.yaml down",
    "db:import": "bash scripts/data/importar-origen.sh",
    "db:verify": "tsx --env-file=.env scripts/data/verificar-origen.ts",
    "db:migrate": "bash scripts/data/migrar-experimental.sh",
    "db:reset-exp": "bash scripts/data/reset-experimental.sh",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "auth:hash": "tsx scripts/auth/hash-password.ts",
    "latencia:api": "tsx --env-file=.env scripts/experiments/latencia-api.ts",
    "dev:null": "LEDGER=null next dev",
    "fabric:up": "bash infra/fabric/network/up.sh",
    "fabric:down": "bash infra/fabric/network/down.sh",
    "fabric:health": "bash infra/fabric/network/health.sh",
    "cc:deploy": "bash infra/fabric/network/deploy-cc.sh",
    "test:cc": "npm --prefix chaincode test",
    "fabric:prueba": "bash infra/fabric/network/prueba-cli.sh"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@hyperledger/fabric-gateway": "^1.13.0",
    "mysql2": "^3.24.6",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
