{
  "name": "investigacion-blockchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose --env-file .env -f infra/mysql/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/mysql/compose.yaml down",
    "db:import": "bash scripts/data/importar-origen.sh",
    "db:verify": "tsx --env-file=.env scripts/data/verificar-origen.ts",
    "db:migrate": "bash scripts/data/migrar-experimental.sh",
    "db:reset-exp": "bash scripts/data/reset-experimental.sh"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "tsx": "^4.23.15"
  }
}
